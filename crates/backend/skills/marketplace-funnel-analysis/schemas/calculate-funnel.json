{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["marketplace", "metrics"],
  "properties": {
    "marketplace": { "enum": ["ozon", "wildberries", "yandex-market"] },
    "label": { "type": "string" },
    "metrics": {
      "type": "object",
      "required": ["orders"],
      "additionalProperties": { "type": ["number", "null"] }
    }
  },
  "additionalProperties": false
}
