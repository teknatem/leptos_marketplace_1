{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["marketplace", "segments"],
  "properties": {
    "marketplace": { "enum": ["ozon", "wildberries", "yandex-market"] },
    "segments": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "type": "object",
        "required": ["segment", "metrics"],
        "properties": {
          "segment": { "type": "string", "minLength": 1 },
          "metrics": { "type": "object", "required": ["orders"] }
        }
      }
    }
  },
  "additionalProperties": false
}
